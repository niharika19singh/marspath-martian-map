# MARSPath Environment Configuration

# Server
MARSPATH_ENV=development
MARSPATH_HOST=0.0.0.0
MARSPATH_PORT=8000
MARSPATH_LOG_LEVEL=INFO

# Security & CORS
# Comma-separated list of allowed origins (e.g. http://localhost:3000,https://marspath.vercel.app)
MARSPATH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Geospatial & Planetary Data Configuration
# Path to local planetary data directory (relative to backend or absolute)
MARSPATH_DATA_DIR=backend/app/data
# Enable real NASA DEM raster loading if local GeoTIFF is present
MARSPATH_USE_REAL_DEM=false
# Path to local Jezero Crater DEM file (GeoTIFF)
MARSPATH_DEM_PATH=backend/app/data/rasters/jezero_mola_hrsc_blended.tif
# Fallback to deterministic synthetic fixture if real raster is absent
MARSPATH_ALLOW_SYNTHETIC_FALLBACK=true

# Routing Engine Constraints
MARSPATH_MAX_GRID_CELLS=250000
MARSPATH_MAX_SEARCH_RADIUS_METERS=50000
MARSPATH_ROUTING_TIMEOUT_SECONDS=10.0
