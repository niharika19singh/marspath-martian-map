# MARSPath Environment Configuration

# Server
MARSPATH_ENV=development
MARSPATH_HOST=0.0.0.0
MARSPATH_PORT=8000
MARSPATH_LOG_LEVEL=INFO

# Security & CORS
# Comma-separated list of allowed origins. For local development, loopback origins are included:
MARSPATH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8080,http://127.0.0.1:8080,https://marspath.vercel.app
# Note: In deployed production (e.g. Render), MARSPATH_CORS_ORIGINS must contain ONLY known hosted origins (e.g. https://marspath.vercel.app).


# Geospatial & Planetary Data Configuration
# Path to local planetary data directory (relative to backend or absolute)
MARSPATH_DATA_DIR=backend/app/data
# Enable real NASA DEM raster loading if local GeoTIFF is present
MARSPATH_USE_REAL_DEM=false
# Path to local Jezero Crater DEM file (GeoTIFF)
MARSPATH_DEM_PATH=backend/app/data/rasters/jezero_mola_hrsc_blended.tif
# Fallback to deterministic synthetic fixture if real raster is absent
MARSPATH_ALLOW_SYNTHETIC_FALLBACK=true

# Routing Engine Constraints
MARSPATH_MAX_GRID_CELLS=250000
MARSPATH_MAX_SEARCH_RADIUS_METERS=50000
MARSPATH_ROUTING_TIMEOUT_SECONDS=10.0

# --- Google Cloud Platform Integration ---
# Project and bucket identifiers
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GCS_BUCKET=marspath-data
GOOGLE_APPLICATION_CREDENTIALS=
GCS_LOCAL_STORAGE_ROOT=backend/app/data/storage
MARSPATH_GCS_ENABLED=false
MARSPATH_CLOUD_JOBS_ENABLED=false

# --- AI Integrations: Mars Science Copilot ---
# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MARSPATH_GEMINI_ENABLED=false

# Microsoft Azure AI Foundry (Optional secondary provider)
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_MODEL=gpt-4o
MARSPATH_AZURE_AI_ENABLED=false

